# Local development default:
AGMS_DATABASE_URL=sqlite:////opt/moegallery/backend/anime_gallery.db
# Production MySQL example:
# AGMS_DATABASE_URL=mysql+pymysql://anime_gallery:change-this-db-password@127.0.0.1:3306/anime_gallery?charset=utf8mb4
AGMS_STORAGE_PATH=/opt/moegallery/storage
AGMS_ADMIN_USERNAME=admin
# The setup page stores the administrator password only as a database hash.
# Generated automatically by /install. If bypassing the setup page, generate one:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# AGMS_AUTH_SECRET=
# Generated automatically by /install. Used by server-side scripts with Authorization: Bearer <key>.
# AGMS_API_KEYS=default:agms_change_this_long_random_key
AGMS_AUTH_TOKEN_TTL_SECONDS=43200
AGMS_COOKIE_SECURE=false
# Comma-separated reverse-proxy networks allowed to supply client IP headers. Loopback is enough for same-host Nginx.
AGMS_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
AGMS_INSTALL_TOKEN_TTL_SECONDS=7200
AGMS_INSTALL_RATE_LIMIT_WINDOW_SECONDS=300
AGMS_INSTALL_RATE_LIMIT_MAX_ATTEMPTS=8
AGMS_MAX_UPLOAD_SIZE=104857600
AGMS_PREVIEW_MAX_SIZE=1600
AGMS_THUMBNAIL_MAX_SIZE=480
AGMS_MEDIA_PUBLIC_BROWSER_CACHE_SECONDS=604800
AGMS_MEDIA_PUBLIC_SHARED_CACHE_SECONDS=2592000
# Optional Nginx internal location prefix, for example /_agms_media. Leave empty for FileResponse.
AGMS_MEDIA_ACCEL_REDIRECT_PREFIX=
# SQLite file databases automatically use WAL. NORMAL is the fast default; use FULL for the strongest power-loss durability.
AGMS_SQLITE_BUSY_TIMEOUT_MS=8000
AGMS_SQLITE_SYNCHRONOUS=NORMAL
AGMS_SQLITE_UPLOAD_WORKER_LIMIT=4
# MySQL/MariaDB pool tuning. These values are read at process start and require a service restart after changes.
AGMS_MYSQL_POOL_SIZE=24
AGMS_MYSQL_MAX_OVERFLOW=40
AGMS_MYSQL_POOL_TIMEOUT_SECONDS=30
AGMS_MYSQL_POOL_RECYCLE_SECONDS=1800
AGMS_MYSQL_CONNECT_TIMEOUT_SECONDS=10
AGMS_MYSQL_READ_TIMEOUT_SECONDS=60
AGMS_MYSQL_WRITE_TIMEOUT_SECONDS=60
# Queue reliability defaults. Max attempts and failed-file retention can also be changed in the admin panel.
AGMS_UPLOAD_TASK_MAX_ATTEMPTS=3
AGMS_UPLOAD_TASK_RETRY_BASE_SECONDS=10
AGMS_UPLOAD_TASK_HEARTBEAT_SECONDS=30
AGMS_UPLOAD_TASK_LEASE_SECONDS=600
AGMS_UPLOAD_TASK_FAILED_RETENTION_DAYS=7
AGMS_UPLOAD_TASK_HISTORY_RETENTION_DAYS=90
AGMS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://gallery.example.com"]
